    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "defaultEnabled": true,
    "components": {
      "GithubSourceLink": {
        "displayName": "GitHub Source Link",
        "defaultPosition": "beforeBody",
        "defaultPriority": 26
      }
    }
  }
}
