{
  "name": "github-source-link",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    }
  },
  "main": "./dist/index.js",
  "quartz": {
    "name": "github-source-link",
    "displayName": "GitHub Source Link",
